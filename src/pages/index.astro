---
const title = 'Vuelta al Trapiche | Rally Bike e inscripciones'
const description =
	'Inscripcion online para Vuelta al Trapiche, la carrera de Mountain Bike en El Trapiche, San Luis.'

const categories = [
	['Promocionales femenino A', 'Hasta 35 anos'],
	['Promocionales femenino B', 'Hasta 45 anos'],
	['Promocionales femenino C', '+45 anos'],
	['Kids camiseta', 'Hasta 3 anos'],
	['Kids rueditas', '4 a 6 anos'],
	['Kids mosquitos', '7 a 9 anos'],
	['Kids infantiles', '10 a 12 anos'],
	['Pre-Juveniles masculinos', '13 a 15 anos - 35k'],
	['Pre-Juveniles femenino', '13 a 15 anos'],
	['Master D2', '65 a 70 anos'],
	['Master E', '+70 anos'],
	['Damas Elite', 'Hasta 30 anos'],
	['Damas A', '31 a 40 anos'],
	['Damas B', '41 a 50 anos'],
	['Damas C', '+51 anos'],
	['Promocionales masculinos A', 'Hasta 30 anos'],
	['Promocionales masculinos B', 'Hasta 40 anos'],
	['Promocionales masculinos C', '+41 anos'],
	['Juveniles', 'Hasta 23 anos'],
	['Elite', 'Hasta 29 anos'],
	['Master A1', '30 a 34 anos'],
	['Master A2', '35 a 39 anos'],
	['Master B1', '40 a 44 anos'],
	['Master B2', '45 a 49 anos'],
	['Master C1', '50 a 54 anos'],
	['Master C2', '55 a 59 anos'],
	['Master D1', '60 a 64 anos']
]

const galleryItems = [
	['Largada', '/assets/4.jpg'],
	['Senderos', '/assets/5.jpg'],
	['Competencia', '/assets/6.jpg'],
	['Rally Bike', '/assets/7.jpg'],
	['El Trapiche', '/assets/8.webp'],
	['Llegada', '/assets/9.jpg'],
	['Montana', '/assets/img3.jpg']
]
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Roboto:wght@900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<nav class="site-nav" id="navbar">
			<a class="brand" href="#inicio" aria-label="Vuelta al Trapiche">
				<img src="/vuelta-logo.jpg" alt="Vuelta al Trapiche" />
				<span>Vuelta al Trapiche <small>Rally Bike</small></span>
			</a>
			<button class="nav-toggle" id="navToggle" aria-label="Abrir menu" aria-expanded="false">
				<span></span><span></span><span></span>
			</button>
			<div class="nav-links" id="navLinks">
				<a href="#eventos">Eventos</a>
				<a href="#inscripcion">Inscripcion</a>
				<a href="#reglamento">Reglamento</a>
				<a href="#recorridos">Recorridos</a>
				<a href="#galeria">Galeria</a>
				<a class="nav-cta" href="#inscripcion">Inscribite</a>
			</div>
		</nav>

		<main>
			<section class="hero" id="inicio">
				<video class="hero-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
					<source src="/assets/video2.mp4" type="video/mp4" />
				</video>
				<div class="hero-bg"></div>
				<div class="particles" aria-hidden="true">
					<span></span><span></span><span></span><span></span><span></span><span></span>
				</div>
				<div class="container hero-content">
					<img class="hero-logo" src="/vuelta-logo.jpg" alt="Vuelta al Trapiche" />
					<p class="badge">Inscripciones abiertas</p>
					<h1>Vuelta al <span>Trapiche</span></h1>
					<p class="hero-kicker">Rally Bike</p>
					<div class="hero-info">
						<span>14 y 15 de noviembre 2026</span>
						<span>El Trapiche, San Luis</span>
						<span>Mountain Bike</span>
					</div>
					<div class="hero-actions">
						<a class="btn primary" href="#inscripcion">Inscribirme ahora</a>
						<a class="btn outline" href="#recorridos">Ver recorridos</a>
					</div>
				</div>
				<svg class="mountains" viewBox="0 0 1440 180" preserveAspectRatio="none" aria-hidden="true">
					<path d="M0 180V98l220-46 210 74 250-96 250 104 230-78 280 82v42H0z" fill="#111827" opacity=".95"></path>
					<path d="M0 180v-42l260-38 214 52 260-70 250 74 240-54 216 48v30H0z" fill="#0a0e17"></path>
				</svg>
			</section>

			<section class="section events" id="eventos">
				<div class="container">
					<p class="section-label">Proximos eventos</p>
					<h2>Elegi tu carrera</h2>
					<div class="event-grid">
						<article class="event-card">
							<div class="event-icon">
								<img src="/vuelta-logo.jpg" alt="" />
							</div>
							<h3>Vuelta al Trapiche 60 km</h3>
							<p class="date">14 y 15 de noviembre 2026</p>
							<p>
								El desafio competitivo de Mountain Bike entre montanas, rios y senderos
								unicos de El Trapiche.
							</p>
							<div class="tags"><span>60 km</span><span>Competitivo</span><span>MTB</span></div>
							<a href="#inscripcion">Inscribirme</a>
						</article>
						<article class="event-card">
							<div class="event-icon orange">
								<img src="/vuelta-logo.jpg" alt="" />
							</div>
							<h3>Vuelta al Trapiche 35 km</h3>
							<p class="date">14 y 15 de noviembre 2026</p>
							<p>
								Un recorrido promocional para disfrutar el paisaje, los caminos serranos y
								la experiencia de correr en El Trapiche.
							</p>
							<div class="tags"><span>35 km</span><span>Promocional</span><span>MTB</span></div>
							<a href="#inscripcion">Inscribirme</a>
						</article>
					</div>
				</div>
			</section>

			<section class="section register" id="inscripcion">
				<div class="container narrow">
					<p class="section-label">Inscripcion online</p>
					<h2>Registrate en minutos</h2>
					<p class="section-copy">
						Completa tus datos, elegi categoria, acepta el reglamento y confirma tu inscripcion.
					</p>
					<form class="form-card" id="registrationForm">
						<div class="form-progress">
							<span class="active">1 Datos</span>
							<span>2 Categoria</span>
							<span>3 Reglamento</span>
							<span>4 Pago</span>
						</div>

						<div class="form-panel active" data-step-panel="0">
							<div class="form-grid">
								<label>Nombre<input name="nombre" type="text" placeholder="Ej: Juan" required /></label>
								<label>Apellido<input name="apellido" type="text" placeholder="Ej: Rodriguez" required /></label>
								<label>DNI<input name="dni" type="text" placeholder="Ej: 32.456.789" required /></label>
								<label>Telefono<input name="telefono" type="tel" placeholder="Ej: 2664-123456" required /></label>
								<label>Email<input name="email" type="email" placeholder="Ej: corredor@email.com" required /></label>
								<label>Fecha de nacimiento<input name="fechaNacimiento" type="text" placeholder="Ej: 15/03/1992" required /></label>
								<label>Localidad<input name="localidad" type="text" placeholder="Ej: San Luis" required /></label>
							</div>
							<label>Equipo<input name="equipo" type="text" placeholder="Ej: Pedal Sur Team" /></label>
							<fieldset class="route-options">
								<legend>Elegí tu recorrido</legend>
								<div>
									<label>
										<input type="radio" name="evento" value="Vuelta al Trapiche - 35 km" required />
										<strong>35 km</strong>
										<span>Recorrido promocional</span>
									</label>
									<label>
										<input type="radio" name="evento" value="Vuelta al Trapiche - 60 km" required />
										<strong>60 km</strong>
										<span>Recorrido competitivo</span>
									</label>
								</div>
							</fieldset>
							<div class="form-buttons">
								<button class="submit form-next" type="button">Continuar</button>
							</div>
						</div>

						<div class="form-panel" data-step-panel="1">
							<div class="categories">
								{
									categories.map(([name, age]) => (
										<button type="button" class="category-button" data-category={`${name} (${age})`}>
											<strong>{name}</strong>
											<span>{age}</span>
										</button>
									))
								}
							</div>
							<input type="hidden" name="categoria" id="categoryInput" required />
							<div class="form-buttons split">
								<button class="submit secondary form-prev" type="button">Volver</button>
								<button class="submit form-next" type="button">Continuar</button>
							</div>
						</div>

						<div class="form-panel" data-step-panel="2">
							<div class="rules">
								<strong>Reglamento:</strong> La inscripcion se realiza unicamente online y queda
								confirmada una vez completado el pago. El corredor acepta las condiciones de
								seguridad, categoria, recorrido y horarios definidos por la organizacion.
							</div>
							
							<a href="/assets/reglamento.pdf" target="_blank" rel="noopener noreferrer">
								<div class="submit form-next">
									<span><i class="fas fa-download"></i> Ver reglamento</span>
								</div>
							</a>
							<label class="check" style="padding-top: 10px;">
								<input name="reglamento" type="checkbox" required /> He leido y acepto el reglamento completo.
							</label>
							<div class="form-buttons split">
								<button class="submit secondary form-prev" type="button">Volver</button>
								<button class="submit form-next" type="button">Continuar</button>
							</div>
						</div>

						<div class="form-panel" data-step-panel="3">
							<div class="payment-box">
								<span>Datos para transferencia</span>
								<div class="payment-prices">
									<div class="payment-price"><span>1 pago</span><strong>$130.000</strong></div>
									<div class="payment-price"><span>2 pagos</span><strong>$70.000</strong><small>cada uno</small></div>
									<div class="payment-price featured"><span>3 pagos</span><strong>$50.000</strong><small>cada uno · solo julio</small></div>
								</div>

								<div class="payment-detail">
									<strong>CBU: <span>1430001713043800340017</span></strong>
									<button type="button" class="copy-button" data-copy="1430001713043800340017" aria-label="Copiar CBU">Copiar</button>
								</div>
								<div class="payment-detail">
									<strong>Alias: <span>vueltaaeltrapiche</span></strong>
									<button type="button" class="copy-button" data-copy="vueltaaeltrapiche" aria-label="Copiar alias">Copiar</button>
								</div>
								<strong>Número de cuenta: 1304380034001</strong>
								<small>CUIT/CUIL: 20 - 28838330 - 9</small>
								<small>Titular: MARIANO DANIEL GIL</small>
							</div>
							<div class="payment-notice">
								<strong>Importante:</strong> una vez realizado el pago, es obligatorio enviar el comprobante por WhatsApp.
								<a href="https://wa.me/5492664630799?text=Hola%2C%20env%C3%ADo%20el%20comprobante%20de%20pago%20de%20mi%20inscripci%C3%B3n%20a%20la%20Vuelta%20al%20Trapiche." target="_blank" rel="noopener noreferrer">Enviar comprobante por WhatsApp</a>
							</div>
							<div class="form-buttons split">
								<button class="submit secondary form-prev" type="button">Volver</button>
								<button class="submit" type="submit">Confirmar inscripcion</button>
							</div>
						</div>
						<p class="form-message" id="formMessage" role="status"></p>
					</form>
				</div>
			</section>

			<section class="section rules-section" id="reglamento">
				<div class="container">
					<div class="rules-layout">
						<div>
							<p class="section-label">Reglamento</p>
							<h2>Condiciones de carrera</h2>
							<p>
								Descarga el reglamento para revisar inscripcion, categorias, seguridad,
								responsabilidades, modificaciones y condiciones generales antes de confirmar tu lugar.
							</p>
						</div>
						<a href="/assets/reglamento.pdf" target="_blank">
						<div class="download-card">
							<span style="padding-top: 100px;">Descargar PDF</span>
							<strong>Reglamento oficial</strong>
							<small>Vuelta al Trapiche 2026</small>							
						</div>
						</a>
					</div>
				</div>
			</section>

			<section class="section routes" id="recorridos">
				<div class="container">
					<p class="section-label">Circuitos</p>
					<h2>Conoce el recorrido</h2>
					<div class="route-grid">
						<article
							class="route-card"
							data-map-title="Recorrido 60 km"
							data-map-image="/assets/60kmfull.jpeg"
							data-map-link="https://maps.app.goo.gl/R3TzMoWtfJbaSdJ4A"
							tabindex="0"
							role="button"
						>
							<div class="map-art">
								<img src="/assets/65k.png" alt="Mapa y perfil de elevación del recorrido de 60 km" loading="lazy" />
							</div>
							<h3>Recorrido 60 km</h3>
							<p>Senderos, caminos serranos y sectores tecnicos para vivir El Trapiche a ritmo de carrera.</p>
							<div class="route-stats"><span>60 km</span><span>Competitivo</span><span>MTB</span></div>
							<span class="route-open">Ver ubicacion</span>
						</article>
						<article
							class="route-card"
							data-map-title="Recorrido 35 km"
							data-map-image="/assets/35kmfull.jpeg"
							data-map-link="https://maps.app.goo.gl/R3TzMoWtfJbaSdJ4A"
							tabindex="0"
							role="button"
						>
							<div class="map-art alt">
								<img src="/assets/35k.png" alt="Mapa y perfil de elevación del recorrido de 35 km" loading="lazy" />
							</div>
							<h3>Recorrido 35 km</h3>
							<p>Una opcion pensada para disfrutar la experiencia con menor exigencia y el mismo entorno natural.</p>
							<div class="route-stats"><span>35 km</span><span>Promocional</span><span>Paisaje</span></div>
							<span class="route-open">Ver ubicacion</span>
						</article>
						<article
							class="route-card"
							data-map-title="Circuito contrarreloj"
							data-map-image="/assets/crono.png"
							data-map-link="https://maps.app.goo.gl/R3TzMoWtfJbaSdJ4A"
							tabindex="0"
							role="button"
						>
							<div class="map-art">
								<img src="/assets/crono.png" alt="Circuito de la contrarreloj" loading="lazy" />
							</div>
							<h3>Circuito contrarreloj</h3>
							<p>La prueba que se realiza el sabado, un dia antes de la carrera principal.</p>
							<div class="route-stats"><span>Contrarreloj</span><span>Sabado</span><span>MTB</span></div>
							<span class="route-open">Ver circuito</span>
						</article>
					</div>
				</div>
			</section>

			<section class="section gallery" id="galeria">
				<div class="container">
					<p class="section-label">Edicion anterior</p>
					<h2>Revivi la experiencia</h2>
					<a class="instagram-link" href="https://www.instagram.com/vueltaaltrapiche/" target="_blank" rel="noopener noreferrer">
						Ver fotos reales en Instagram
					</a>
					<div class="gallery-grid">
						{galleryItems.map(([label, src], index) => (
							<article class={`gallery-item item-${index + 1}`}>
								<img src={src} alt={`Vuelta al Trapiche - ${label}`} loading="lazy" />
								<span>{label}</span>
							</article>
						))}
					</div>
				</div>
			</section>
		</main>

		<div class="map-modal" id="mapModal" aria-hidden="true">
			<div class="map-modal__backdrop" data-map-close></div>
			<div class="map-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="mapModalTitle">
				<div class="map-modal__header">
					<div>
						<p class="section-label">Ubicacion</p>
						<h2 id="mapModalTitle">Recorrido</h2>
					</div>
					<button class="map-modal__close" type="button" data-map-close aria-label="Cerrar mapa">×</button>
				</div>
				<img id="mapImage" class="map-modal__image" src="" alt="" />
				<a class="map-modal__external" id="mapExternalLink" href="https://maps.app.goo.gl/R3TzMoWtfJbaSdJ4A" target="_blank">
					Abrir en Google Maps
				</a>
			</div>
		</div>

		<a
			class="whatsapp-float"
			href="https://wa.me/5492664630799?text=Quiero%20informacion%20sobre%20la%20Vuelta%20al%20Trapiche"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Contactar por WhatsApp"
			title="WhatsApp"
		>
			<svg viewBox="0 0 32 32" aria-hidden="true">
				<path d="M16.04 3A12.8 12.8 0 0 0 5.06 22.38L3.25 29l6.78-1.78A12.8 12.8 0 1 0 16.04 3Zm0 23.42c-1.9 0-3.77-.51-5.4-1.48l-.39-.23-4.02 1.05 1.08-3.92-.25-.4a10.64 10.64 0 1 1 8.98 4.98Zm5.84-7.96c-.32-.16-1.9-.94-2.2-1.05-.29-.11-.5-.16-.72.16-.21.32-.82 1.05-1.01 1.26-.18.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59a9.63 9.63 0 0 1-1.78-2.21c-.19-.32-.02-.49.14-.65.15-.14.32-.37.48-.56.16-.18.21-.31.32-.52.11-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.11 1.08-1.11 2.64 0 1.55 1.14 3.06 1.29 3.27.16.21 2.23 3.4 5.4 4.77.75.32 1.34.52 1.8.67.76.24 1.45.21 1.99.13.61-.09 1.9-.78 2.17-1.53.26-.75.26-1.4.18-1.53-.08-.13-.29-.21-.61-.37Z" />
			</svg>
		</a>

		<footer>
			<div class="container footer-grid">
				<div>
					<div class="footer-brand"><img src="/vuelta-logo.jpg" alt="" /> Vuelta al Trapiche</div>
					<p>La carrera de Mountain Bike mas emocionante de San Luis.</p>
				</div>
				<div>
					<h3>Navegacion</h3>
					<a href="#eventos">Eventos</a>
					<a href="#inscripcion">Inscripcion</a>
					<a href="#reglamento">Reglamento</a>
					<a href="#recorridos">Recorridos</a>
					<a href="#galeria">Galeria</a>
				</div>
				<div>
					<h3>Contacto</h3>
					<a href="https://www.instagram.com/vueltaaltrapiche/" target="_blank" rel="noopener noreferrer">@vueltaaltrapiche</a>
					<a href="mailto:vueltaaltrapiche@gmail.com">vueltaaltrapiche@gmail.com</a>
					<span>El Trapiche, San Luis</span>
				</div>
			</div>
			<div class="container copyright">
				<span>&copy; 2026 Vuelta al Trapiche. Organiza: Don Juan Evento Deportivo.</span>
				<a href="https://doblebe.com.ar" target="_blank">Desarrollado por Doblebe.com.ar</a>
			</div>
		</footer>

		<script>
			const nav = document.getElementById('navbar')
			const toggle = document.getElementById('navToggle')
			const links = document.getElementById('navLinks')

			window.addEventListener('scroll', () => {
				nav?.classList.toggle('scrolled', window.scrollY > 50)
			})

			toggle?.addEventListener('click', () => {
				const isOpen = links?.classList.toggle('open')
				toggle.setAttribute('aria-expanded', String(isOpen))
			})

			links?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					links.classList.remove('open')
					toggle?.setAttribute('aria-expanded', 'false')
				})
			})

			document.querySelectorAll('.copy-button').forEach((copyButton) => {
				copyButton.addEventListener('click', async () => {
					const button = copyButton as HTMLButtonElement
					const value = button.dataset.copy || ''
					const originalLabel = button.textContent || 'Copiar'

					try {
						if (navigator.clipboard && window.isSecureContext) {
							await navigator.clipboard.writeText(value)
						} else {
							const input = document.createElement('textarea')
							input.value = value
							input.style.position = 'fixed'
							input.style.opacity = '0'
							document.body.appendChild(input)
							input.select()
							document.execCommand('copy')
							input.remove()
						}
						button.textContent = 'Copiado'
					} catch {
						button.textContent = 'No se pudo copiar'
					}

					window.setTimeout(() => {
						button.textContent = originalLabel
					}, 1800)
				})
			})

			const form = document.getElementById('registrationForm') as HTMLFormElement | null
			const categoryInput = document.getElementById('categoryInput') as HTMLInputElement | null
			const formMessage = document.getElementById('formMessage') as HTMLElement | null
			const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null
			const stepPanels = Array.from(document.querySelectorAll('[data-step-panel]')) as HTMLElement[]
			const progressItems = Array.from(document.querySelectorAll('.form-progress span')) as HTMLElement[]
			const nextButtons = Array.from(document.querySelectorAll('.form-next')) as HTMLButtonElement[]
			const prevButtons = Array.from(document.querySelectorAll('.form-prev')) as HTMLButtonElement[]
			const mapModal = document.getElementById('mapModal') as HTMLElement | null
			const mapImage = document.getElementById('mapImage') as HTMLImageElement | null
			const mapModalTitle = document.getElementById('mapModalTitle') as HTMLElement | null
			const mapExternalLink = document.getElementById('mapExternalLink') as HTMLAnchorElement | null
			let currentStep = 0

			const closeMapModal = () => {
				if (!mapModal) return
				mapModal.classList.remove('open')
				mapModal.setAttribute('aria-hidden', 'true')
				document.body.classList.remove('modal-open')
				if (mapImage) {
					mapImage.removeAttribute('src')
					mapImage.alt = ''
				}
			}

			document.querySelectorAll('.route-card').forEach((routeCard) => {
				const openMap = () => {
					const card = routeCard as HTMLElement
					if (!mapModal || !mapImage) return
					const routeTitle = card.dataset.mapTitle || 'Recorrido'
					mapImage.src = card.dataset.mapImage || ''
					mapImage.alt = `Mapa completo del ${routeTitle.toLowerCase()}`
					if (mapModalTitle) {
						mapModalTitle.textContent = routeTitle
					}
					if (mapExternalLink) {
						mapExternalLink.href = card.dataset.mapLink || 'https://maps.app.goo.gl/R3TzMoWtfJbaSdJ4A'
					}
					mapModal.classList.add('open')
					mapModal.setAttribute('aria-hidden', 'false')
					document.body.classList.add('modal-open')
				}

				routeCard.addEventListener('click', openMap)
				routeCard.addEventListener('keydown', (event) => {
					if (event instanceof KeyboardEvent && (event.key === 'Enter' || event.key === ' ')) {
						event.preventDefault()
						openMap()
					}
				})
			})

			document.querySelectorAll('[data-map-close]').forEach((closeButton) => {
				closeButton.addEventListener('click', closeMapModal)
			})

			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') {
					closeMapModal()
				}
			})

			document.querySelectorAll('.category-button').forEach((button) => {
				button.addEventListener('click', () => {
					document.querySelectorAll('.category-button').forEach((item) => item.classList.remove('selected'))
					button.classList.add('selected')
					if (categoryInput) {
						categoryInput.value = (button as HTMLButtonElement).dataset.category || ''
					}
					if (formMessage) {
						formMessage.textContent = ''
					}
				})
			})

			const setStep = (step: number) => {
				currentStep = Math.max(0, Math.min(step, stepPanels.length - 1))
				stepPanels.forEach((panel, index) => {
					panel.classList.toggle('active', index === currentStep)
				})
				progressItems.forEach((item, index) => {
					item.classList.toggle('active', index === currentStep)
					item.classList.toggle('done', index < currentStep)
				})
				if (formMessage) {
					formMessage.textContent = ''
				}
			}

			const validateStep = (step: number) => {
				const panel = stepPanels[step]
				if (!panel || !form) return true

				const fields = Array.from(panel.querySelectorAll('input, select, textarea')) as Array<
					HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
				>

				if (step === 1 && !categoryInput?.value) {
					if (formMessage) {
						formMessage.textContent = 'Selecciona una categoria para continuar.'
					}
					return false
				}

				for (const field of fields) {
					if (!field.checkValidity()) {
						field.reportValidity()
						return false
					}
				}

				return true
			}

			nextButtons.forEach((button) => {
				button.addEventListener('click', () => {
					if (validateStep(currentStep)) {
						setStep(currentStep + 1)
					}
				})
			})

			prevButtons.forEach((button) => {
				button.addEventListener('click', () => {
					setStep(currentStep - 1)
				})
			})

			form?.addEventListener('submit', async (event) => {
				event.preventDefault()
				if (!categoryInput?.value) {
					if (formMessage) {
						formMessage.textContent = 'Selecciona una categoria para continuar.'
					}
					return
				}

				if (!form.checkValidity()) {
					form.reportValidity()
					return
				}

				const data = new FormData(form)

				if (formMessage) {
					formMessage.textContent = 'Enviando inscripcion...'
				}
				if (submitButton) {
					submitButton.disabled = true
					submitButton.textContent = 'Enviando...'
				}

				try {
					const res = await fetch('/api/inscripcion', {
						method: 'POST',
						body: data
					})
					const result = await res.json()

					if (!res.ok || !result.ok) {
						throw new Error(result.message || 'No se pudo enviar la inscripcion.')
					}

					form.reset()
					categoryInput.value = ''
					document.querySelectorAll('.category-button').forEach((item) => item.classList.remove('selected'))
					setStep(0)
					if (formMessage) {
						formMessage.textContent = 'Inscripcion enviada. Te enviamos una copia por email.'
					}
				} catch (error) {
					if (formMessage) {
						formMessage.textContent =
							error instanceof Error ? error.message : 'No se pudo enviar la inscripcion.'
					}
				} finally {
					if (submitButton) {
						submitButton.disabled = false
						submitButton.textContent = 'Confirmar inscripcion'
					}
				}
			})
		</script>
	</body>
</html>

